<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Создать автора - I.N.S.P.I.R.I.O</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Urbanist:wght@400;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="../styles.css">
    <style>
        .admin-container {
            max-width: 700px;
            margin: 50px auto;
            padding: 40px;
            background-color: #ffffff;
            border-radius: 20px;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.1);
        }

        .admin-header {
            margin-bottom: 40px;
            padding-bottom: 20px;
            border-bottom: 2px solid #e0e0e0;
        }

        .admin-header h1 {
            font-size: 32px;
            font-weight: 700;
            color: #000000;
            margin-bottom: 10px;
        }

        .form-group {
            margin-bottom: 24px;
        }

        .form-group label {
            display: block;
            margin-bottom: 8px;
            font-weight: 600;
            color: #333333;
            font-size: 14px;
        }

        .form-group input,
        .form-group textarea {
            width: 100%;
            padding: 12px 16px;
            border: 1px solid #e0e0e0;
            border-radius: 8px;
            font-family: 'Urbanist', sans-serif;
            font-size: 16px;
            transition: border-color 0.3s ease;
        }

        .form-group input:focus,
        .form-group textarea:focus {
            outline: none;
            border-color: #000000;
        }

        .form-group small {
            display: block;
            margin-top: 6px;
            color: #666666;
            font-size: 12px;
        }

        .avatar-preview {
            margin-top: 12px;
            width: 120px;
            height: 120px;
            border-radius: 50%;
            overflow: hidden;
            border: 3px solid #e0e0e0;
            object-fit: cover;
        }

        .submit-button {
            background-color: #000000;
            color: #ffffff;
            border: none;
            padding: 16px 32px;
            border-radius: 12px;
            font-family: 'Urbanist', sans-serif;
            font-size: 16px;
            font-weight: 600;
            cursor: pointer;
            transition: background-color 0.3s ease;
            width: 100%;
        }

        .submit-button:hover {
            background-color: #333333;
        }

        .submit-button:disabled {
            background-color: #cccccc;
            cursor: not-allowed;
        }

        .message {
            padding: 16px;
            border-radius: 8px;
            margin-bottom: 24px;
            font-size: 14px;
        }

        .message.success {
            background-color: #d4edda;
            color: #155724;
            border: 1px solid #c3e6cb;
        }

        .message.error {
            background-color: #f8d7da;
            color: #721c24;
            border: 1px solid #f5c6cb;
        }

        .back-link {
            display: inline-block;
            margin-bottom: 20px;
            color: #000000;
            text-decoration: none;
            font-weight: 600;
            transition: opacity 0.3s ease;
        }

        .back-link:hover {
            opacity: 0.6;
        }
    </style>
    <script src="https://unpkg.com/@supabase/supabase-js@2"></script>
    <script src="../supabase-config.js"></script>
</head>
<body style="background-color: #F6F4F0; padding: 20px;">
    <div class="admin-container">
        <a href="admin.html" class="back-link">← Назад к загрузке карточки</a>
        
        <div class="admin-header">
            <h1>Создать нового автора</h1>
            <p>Заполните информацию об авторе</p>
        </div>

        <div id="message"></div>

        <form id="authorForm">
            <div class="form-group">
                <label for="name">Имя автора *</label>
                <input type="text" id="name" name="name" required>
                <small>Например: AVA Digital, Studio Design</small>
            </div>

            <div class="form-group">
                <label for="slug">URL-адрес (slug) *</label>
                <input type="text" id="slug" name="slug" required pattern="[a-z0-9-]+">
                <small>Только строчные буквы, цифры и дефисы. Например: ava-digital</small>
            </div>

            <div class="form-group">
                <label for="avatar">Аватар</label>
                <input type="file" id="avatar" name="avatar" accept="image/*">
                <small>Рекомендуемый размер: 200×200px</small>
                <img id="avatarPreview" class="avatar-preview" style="display: none;">
            </div>

            <div class="form-group">
                <label for="bio">Биография</label>
                <textarea id="bio" name="bio" rows="4"></textarea>
                <small>Краткое описание автора (необязательно)</small>
            </div>

            <div class="form-group">
                <label for="website">Сайт</label>
                <input type="url" id="website" name="website" placeholder="https://example.com">
                <small>Ссылка на сайт автора (необязательно)</small>
            </div>

            <button type="submit" class="submit-button" id="submitButton">
                Создать автора
            </button>
        </form>
    </div>

    <script>
        // Автоматическое создание slug из имени
        document.getElementById('name').addEventListener('input', function(e) {
            const name = e.target.value;
            const slug = name
                .toLowerCase()
                .replace(/[^a-z0-9]+/g, '-')
                .replace(/^-+|-+$/g, '');
            
            const slugInput = document.getElementById('slug');
            if (!slugInput.value || slugInput.dataset.manual !== 'true') {
                slugInput.value = slug;
            }
        });

        // Пометка ручного редактирования slug
        document.getElementById('slug').addEventListener('input', function(e) {
            e.target.dataset.manual = 'true';
        });

        // Превью аватара
        document.getElementById('avatar').addEventListener('change', function(e) {
            const file = e.target.files[0];
            if (file) {
                const reader = new FileReader();
                reader.onload = function(e) {
                    const preview = document.getElementById('avatarPreview');
                    preview.src = e.target.result;
                    preview.style.display = 'block';
                };
                reader.readAsDataURL(file);
            } else {
                document.getElementById('avatarPreview').style.display = 'none';
            }
        });

        // Обработка отправки формы
        document.getElementById('authorForm').addEventListener('submit', async function(e) {
            e.preventDefault();
            
            const submitButton = document.getElementById('submitButton');
            submitButton.disabled = true;
            submitButton.textContent = 'Создание...';

            const name = document.getElementById('name').value.trim();
            const slug = document.getElementById('slug').value.trim();
            const bio = document.getElementById('bio').value.trim();
            const website = document.getElementById('website').value.trim();
            const avatarFile = document.getElementById('avatar').files[0];

            if (!name) {
                showMessage('Введите имя автора', 'error');
                submitButton.disabled = false;
                submitButton.textContent = 'Создать автора';
                return;
            }

            if (!slug) {
                showMessage('Введите slug', 'error');
                submitButton.disabled = false;
                submitButton.textContent = 'Создать автора';
                return;
            }

            // Проверка формата slug
            if (!/^[a-z0-9-]+$/.test(slug)) {
                showMessage('Slug может содержать только строчные буквы, цифры и дефисы', 'error');
                submitButton.disabled = false;
                submitButton.textContent = 'Создать автора';
                return;
            }

            try {
                let avatarUrl = null;

                // Загружаем аватар, если есть
                if (avatarFile) {
                    const fileName = `avatars/${Date.now()}_${avatarFile.name}`;
                    const { data: uploadData, error: uploadError } = await supabase.storage
                        .from('author-avatars')
                        .upload(fileName, avatarFile);

                    if (uploadError) {
                        throw new Error(`Ошибка загрузки аватара: ${uploadError.message}`);
                    }

                    const { data: { publicUrl } } = supabase.storage
                        .from('author-avatars')
                        .getPublicUrl(fileName);
                    
                    avatarUrl = publicUrl;
                }

                // Создаем автора
                const { data: authorData, error: authorError } = await supabase
                    .from('authors')
                    .insert({
                        name: name,
                        slug: slug,
                        bio: bio || null,
                        website: website || null,
                        avatar_url: avatarUrl
                    })
                    .select()
                    .single();

                if (authorError) {
                    if (authorError.code === '23505') {
                        throw new Error('Автор с таким slug уже существует');
                    }
                    throw new Error(`Ошибка создания автора: ${authorError.message}`);
                }

                showMessage('✅ Автор успешно создан!', 'success');
                
                // Очищаем форму через 2 секунды
                setTimeout(() => {
                    document.getElementById('authorForm').reset();
                    document.getElementById('avatarPreview').style.display = 'none';
                    document.getElementById('slug').dataset.manual = 'false';
                }, 2000);

            } catch (error) {
                console.error('Ошибка:', error);
                showMessage(`❌ Ошибка: ${error.message}`, 'error');
            } finally {
                submitButton.disabled = false;
                submitButton.textContent = 'Создать автора';
            }
        });

        // Показ сообщений
        function showMessage(text, type) {
            const messageDiv = document.getElementById('message');
            messageDiv.textContent = text;
            messageDiv.className = `message ${type}`;
            messageDiv.style.display = 'block';

            if (type === 'success') {
                setTimeout(() => {
                    messageDiv.style.display = 'none';
                }, 5000);
            }
        }

        // Инициализация
        document.addEventListener('DOMContentLoaded', () => {
            if (typeof supabase === 'undefined') {
                showMessage('Ошибка: Supabase не подключен! Проверьте supabase-config.js', 'error');
            }
        });
    </script>
</body>
</html>

